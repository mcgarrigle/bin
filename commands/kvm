#!/bin/bash

function command_ls {
  virsh list --all
}

function command_copy {
  FILE=$(basename "$1")
  virsh vol-create-as --pool "${POOL}" --name "${FILE}" --capacity 1m
  virsh vol-upload --pool "${POOL}" --vol "${FILE}" --file "$1"
}

function command_vols {
  virsh vol-list --pool "${POOL}"
}

function command_info {
  virsh dominfo --domain "$1"
  virsh domblklist --domain "$1"
}

function command_rm {
  virsh destroy --domain "$1"
  virsh undefine --domain "$1" --nvram --remove-all-storage
}

function command_help {
  echo "kvm - manage kvm VMs"
  echo
  echo "kvm ls            - list domains"
  echo "kvm info <name>   - get domain info"
  echo "kvm copy <file>   - copy file as a new volume in pool \$POOL"
  echo "kvm rm <name>     - delete domain and attached volumes"
  echo "kvm vols          - list volumes in pool \$POOL"
}

POOL="${POOL:-filesystems}"

COMMAND="${1:-help}"
shift
command_${COMMAND} $@
